# Local development overrides. Next.js loads this file when NODE_ENV=development.
# Production (`next build`/`next start`) does not load it.
#
# DATABASE_URL is intentionally not set here, so local development uses the
# existing Neon connection from `.env`. Dedicated test URLs live only in the
# guarded test/fixture scripts (LOCAL_AUTH_TEST_DATABASE_URL and
# CATALOGUE_TEST_DATABASE_URL) and never fall back to this value.
BETTER_AUTH_SECRET=local-development-only-not-a-production-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_REPLY_TO=support@example.test
