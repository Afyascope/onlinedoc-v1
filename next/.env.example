# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@ep-xxxxx.aws.neon.tech/neondb?sslmode=require

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEBSITE_URL=localhost:3000
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-secret
# Production: set BETTER_AUTH_URL to the deployed frontend origin.
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=OnlineDoc
EMAIL_FROM_ADDRESS=noreply@onlinedoc.co.ke
EMAIL_REPLY_TO=support@onlinedoc.co.ke

# Strapi
NEXT_PUBLIC_API_URL=http://localhost:1337
PREVIEW_SECRET=replace-with-a-long-random-secret
REVALIDATE_SECRET=replace-with-a-long-random-secret

# Paystack
# ---------------------------------------------------------------------------
# Two separate environments: TEST and LIVE. Do NOT mix keys.
#   - PAYSTACK_SECRET_KEY is server-only. Never expose it to the browser or a
#     NEXT_PUBLIC_* variable.
#   - NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY is client-safe. It may be embedded in
#     the browser bundle. (The current marketplace checkout initialises
#     Paystack server-side and does not require the public key client-side,
#     but it is kept here for the consultation inline flow and future use.)
#
# TEST:
#   PAYSTACK_SECRET_KEY=sk_test_...
#   NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
#
# LIVE:
#   PAYSTACK_SECRET_KEY=sk_live_...
#   NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_CURRENCY=KES

# Consultation pricing (server-side only)
CONSULTATION_FEE=50

# Private product storage (production). The R2 bucket must not be public.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=onlinedoc-products
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRODUCT_PREFIX=products/

# Development-only seed route. Leave unset in production.
SEED_ADMIN_PASSWORD=
SEED_CLINICIAN_PASSWORD=
SEED_PATIENT_PASSWORD=
