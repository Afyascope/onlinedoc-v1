{
  "kind": "collectionType",
  "collectionName": "conditions",
  "info": {
    "singularName": "condition",
    "pluralName": "conditions",
    "displayName": "Conditions",
    "description": "Patient-facing information about health conditions."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "name", "pluginOptions": { "i18n": { "localized": true } } },
    "shortDescription": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "overview": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "causes": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "symptoms": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "riskFactors": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "diagnosis": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "investigations": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "treatmentAndManagement": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "prevention": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "whenToSeekCare": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo", "pluginOptions": { "i18n": { "localized": true } } },
    "image": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": true } } },
    "category": { "type": "relation", "relation": "manyToOne", "target": "api::category.category", "inversedBy": "conditions" },
    "articles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article", "inversedBy": "conditions" },
    "treatments": { "type": "relation", "relation": "manyToMany", "target": "api::treatment.treatment", "inversedBy": "conditions" },
    "medicalTests": { "type": "relation", "relation": "manyToMany", "target": "api::medical-test.medical-test", "inversedBy": "conditions" },
    "nutritionGuides": { "type": "relation", "relation": "manyToMany", "target": "api::nutrition-guide.nutrition-guide", "inversedBy": "conditions" },
    "healthGuides": { "type": "relation", "relation": "manyToMany", "target": "api::health-guide.health-guide", "mappedBy": "conditions" }
  }
}
