HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified


CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# Production: DATABASE_CLIENT=postgres and DATABASE_URL=postgresql://...
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
UPLOAD_PROVIDER=local
# Production: UPLOAD_PROVIDER=aws-s3 (S3-compatible Cloudflare R2 upload provider).
# The R2 bucket must not be public. These variables are server-side only and
# must never be exposed to the browser.
#
# Non-secret configuration:
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=onlinedoc-products
R2_PRODUCT_PREFIX=products/
# Secret credentials (server-only):
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PREVIEW_SECRET=tobemodified # optional, required with Next.js draft mode
