{
  "kind": "collectionType",
  "collectionName": "nutrition_guides",
  "info": { "singularName": "nutrition-guide", "pluralName": "nutrition-guides", "displayName": "Nutrition Guides", "description": "Informational nutrition and meal-planning content." },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "title", "pluginOptions": { "i18n": { "localized": true } } },
    "shortDescription": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "content": { "type": "customField", "customField": "plugin::better-blocks.better-blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo", "pluginOptions": { "i18n": { "localized": true } } },
    "image": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": true } } },
    "conditions": { "type": "relation", "relation": "manyToMany", "target": "api::condition.condition", "inversedBy": "nutritionGuides" },
    "articles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article", "inversedBy": "nutritionGuides" }
  }
}
